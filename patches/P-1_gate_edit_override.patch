From 4289afb17fdbd0bec2f6401f644b631bdd23e764 Mon Sep 17 00:00:00 2001
From: "HOST6\\wh429" <webmaster@commence.com>
Date: Fri, 9 Oct 2026 20:25:09 -0400
Subject: [PATCH] P-1: GATE_EDIT launch override for guard_gates; gate
 settings.local.json

A person who means to change the gates launches Claude Code with
GATE_EDIT=1. Hooks inherit the launch environment; a Bash call inside the
session cannot set it, and settings.local.json (whose env and
disableAllHooks keys could) is now itself a gate. Every edit let through
is announced to the agent. Only the exact value "1" opens the gates, and it
never excuses a payload with no path.

RED first: the settings.local.json test and the override test failed on
the base; six controls pin what must stay denied. Two new mutants
(settings.local.json dropped, any value accepted) are killed: 23 of 23.

Applied by a person: guard_gates refuses this edit from inside a turn.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .claude/hooks/guard_gates.py    | 29 +++++++++++++++++++++--
 tests/integration/test_hooks.py | 42 ++++++++++++++++++++++++++++++++-
 tools/mutation_check.py         | 12 ++++++++++
 3 files changed, 80 insertions(+), 3 deletions(-)

diff --git a/.claude/hooks/guard_gates.py b/.claude/hooks/guard_gates.py
index 35372b4..c8e1f28 100644
--- a/.claude/hooks/guard_gates.py
+++ b/.claude/hooks/guard_gates.py
@@ -15,12 +15,21 @@ work. Hooks that judged the work itself (is anything failing, is this a
 TDD-shaped edit) were measured in another project: about 18 refusals and 0
 defects caught. This is the one refusal that was unambiguously right.
 
+THE OVERRIDE. A person who means to change the gates launches Claude Code
+with GATE_EDIT=1 in its environment. A hook inherits the environment Claude
+Code was launched with; a Bash call made inside the session cannot set it,
+and settings.local.json, whose `env` key could, is itself a gate. Every edit
+the override lets through is announced to the agent, so it is never silent.
+Only the exact value "1" opens the gates, and it never excuses a payload
+the hook cannot judge.
+
 Its limit, written down so it is not trusted past it: Bash is not covered.
 A script can still write these files. This raises the cost of weakening a
 gate from nothing to doing it visibly.
 """
 
 import json
+import os
 import sys
 from pathlib import PurePath
 
@@ -30,11 +39,13 @@ import guard_shared
 GATES = (
     (".claude", "hooks"),
     (".claude", "settings.json"),
+    (".claude", "settings.local.json"),
     (".github", "workflows"),
     ("ruff.toml",),
     ("pyrefly.toml",),
     ("tools", "mutation_check.py"),
 )
+OVERRIDE = "GATE_EDIT"
 
 
 def edit_allowed(path: str | None) -> tuple[bool, str]:
@@ -52,6 +63,15 @@ def edit_allowed(path: str | None) -> tuple[bool, str]:
     return True, ""
 
 
+def announce(path: str) -> None:
+    """Let a gate edit through under the launch override, and say so."""
+    print(json.dumps({"hookSpecificOutput": {
+        "hookEventName": "PreToolUse",
+        "additionalContext": (f"gate edit to {path} allowed by {OVERRIDE}=1, set when this "
+                              f"session was launched. A person must review this change."),
+    }}))
+
+
 def main() -> int:
     raw = sys.stdin.read()
     try:
@@ -62,8 +82,13 @@ def main() -> int:
         return 0
     if data.get("tool_name") not in ("Write", "Edit", "MultiEdit"):
         return 0
-    ok, why = edit_allowed((data.get("tool_input") or {}).get("file_path"))
-    if not ok:
+    path = (data.get("tool_input") or {}).get("file_path")
+    ok, why = edit_allowed(path)
+    if ok:
+        return 0
+    if path and path.strip() and os.environ.get(OVERRIDE) == "1":
+        announce(path)
+    else:
         guard_shared.deny(why)
     return 0
 
diff --git a/tests/integration/test_hooks.py b/tests/integration/test_hooks.py
index 7a0b36f..38dafb6 100644
--- a/tests/integration/test_hooks.py
+++ b/tests/integration/test_hooks.py
@@ -6,9 +6,11 @@ through its pure functions or its stdin/stdout contract.
 
 import importlib.util
 import json
+import os
 import subprocess
 import sys
 from pathlib import Path
+from types import MappingProxyType
 
 import pytest
 
@@ -40,7 +42,7 @@ def run_hook(name: str, payload: dict | str) -> dict | None:
 
 
 def denied(decision: dict | None) -> bool:
-    return bool(decision) and decision["hookSpecificOutput"]["permissionDecision"] == "deny"
+    return bool(decision) and decision["hookSpecificOutput"].get("permissionDecision") == "deny"
 
 
 # --- guard_gates: the gates cannot be edited inside a gated turn ------------
@@ -85,6 +87,44 @@ def test_gate_hook_denies_an_unreadable_payload():
     assert denied(run_hook("guard_gates", "{not json"))
 
 
+def test_settings_local_json_is_a_gate():
+    # Its `disableAllHooks` and `env` keys can switch every gate off.
+    ok, why = load("guard_gates").edit_allowed(".claude/settings.local.json")
+    assert not ok and why
+
+
+def run_gates_launched_with(gate_edit: str | None, payload: dict) -> dict | None:
+    """guard_gates as Claude Code runs it, in a process launched with or
+    without GATE_EDIT. A hook inherits the launch env; a Bash call cannot set it."""
+    env = {k: v for k, v in os.environ.items() if k != "GATE_EDIT"}
+    if gate_edit is not None:
+        env["GATE_EDIT"] = gate_edit
+    r = subprocess.run([sys.executable, str(HOOKS / "guard_gates.py")],
+                       input=json.dumps(payload), capture_output=True, text=True, cwd=ROOT, env=env)
+    assert r.returncode == 0, r.stderr
+    return json.loads(r.stdout) if r.stdout.strip() else None
+
+
+GATE_EDIT_PAYLOAD = MappingProxyType({"tool_name": "Edit", "tool_input": {"file_path": str(ROOT / "ruff.toml")}})
+
+
+def test_a_launch_override_lets_a_person_open_the_gates_and_says_so():
+    decision = run_gates_launched_with("1", dict(GATE_EDIT_PAYLOAD))
+    assert not denied(decision)
+    assert decision is not None and "GATE_EDIT" in decision["hookSpecificOutput"]["additionalContext"]
+
+
+@pytest.mark.control("pins that only the exact value 1 opens the gates; base denies all of these")
+@pytest.mark.parametrize("value", [None, "0", "", "true", "yes"])
+def test_anything_but_gate_edit_1_keeps_the_gates_shut(value):
+    assert denied(run_gates_launched_with(value, dict(GATE_EDIT_PAYLOAD)))
+
+
+@pytest.mark.control("pins that the override never excuses a payload the hook cannot judge")
+def test_the_override_does_not_wave_through_a_payload_with_no_path():
+    assert denied(run_gates_launched_with("1", {"tool_name": "Edit", "tool_input": {}}))
+
+
